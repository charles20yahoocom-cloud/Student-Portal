<%- include('../partials/header', { user: user }) %>
  <%- include('../partials/staff-topnav', { active: 'students', links: [['/dean/dashboard','Dashboard'],['/dean/year-levels','Year Levels'],['/dean/grade-entry','Grade Entry'],['/dean/assignments','Assignments'],['/dean/accounts','Accounts'],['/dean/reports','Reports'],['/profile','Profile']] }) %>

<div class="flex min-h-screen">
  <!-- Sidebar -->
  <aside class="hidden lg:flex lg:flex-col lg:w-64 lg:shrink-0 bg-white shadow-lg">
    <div class="p-6 border-b">
      <div class="flex items-center space-x-3">
        <div class="w-12 h-12 bg-pcc-blue rounded-full flex items-center justify-center">
          <span class="text-white font-bold text-lg">D</span>
        </div>
        <div>
          <p class="font-semibold text-gray-800"><%= user.fullName %></p>
          <p class="text-xs text-gray-500 capitalize"><%= user.role %></p>
        </div>
      </div>
    </div>

    <nav class="p-4 space-y-2">
      <a href="/dean/dashboard" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition"><span>Dashboard</span></a>
      <a href="/dean/grade-entry" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition"><span>Grade Entry</span></a>
      <a href="/dean/assignments" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition"><span>Assignments</span></a>
      <a href="/dean/accounts" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition"><span>Accounts</span></a>
      <a href="/dean/reports" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition"><span>Reports</span></a>
    </nav>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 min-w-0 p-4 sm:p-6 lg:p-8">
    <div class="mb-6 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-800">Students</h1>
        <p class="text-gray-600 mt-1">Manage student records and prospectus</p>
      </div>
      <div class="relative">
        <input 
          type="text"
          id="searchInput"
          placeholder="Search student..."
          class="px-4 py-2 pl-10 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pcc-blue focus:border-transparent outline-none"
        >
        <svg class="w-5 h-5 text-gray-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
    </div>

    <div class="panel overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Student No.</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Program</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Year</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 student-rows">
            <% students.forEach(s => { %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap font-medium text-gray-800"><%= s.student_no %></td>
                <td class="px-6 py-4 text-gray-600"><%= s.last_name %>, <%= s.first_name %></td>
                <td class="px-6 py-4 text-gray-600"><%= s.program_code %></td>
                <td class="px-6 py-4 text-gray-600">Year <%= s.year_level %></td>
                <td class="px-6 py-4">
                  <span class="px-3 py-1 rounded-full text-sm font-medium 
                    <%= s.status === 'active' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-600' %>">
                    <%= s.status %>
                  </span>
                </td>
                <td class="px-6 py-4">
                  <a href="/dean/prospectus/<%= s.id %>" class="text-pcc-blue hover:text-pcc-blue-dark text-sm font-medium">
                    View Prospectus →
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<script>
  // Search functionality
  document.getElementById('searchInput').addEventListener('input', function() {
    const query = this.value.toLowerCase();
    document.querySelectorAll('.student-rows tr').forEach(row => {
      const text = row.textContent.toLowerCase();
      row.style.display = text.includes(query) ? '' : 'none';
    });
  });
</script>

<%- include('../partials/footer') %>