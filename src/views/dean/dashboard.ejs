<%- include('../partials/header', { user: user }) %>
  <%- include('../partials/staff-topnav', { active: 'dashboard', links: [['/dean/dashboard','Dashboard'],['/dean/year-levels','Year Levels'],['/dean/students','Students'],['/dean/grade-entry','Grade Entry'],['/dean/assignments','Assignments'],['/dean/accounts','Accounts'],['/dean/reports','Reports'],['/profile','Profile']] }) %>

<div class="flex min-h-screen">
  <!-- Sidebar -->
  <aside class="hidden lg:flex lg:flex-col lg:w-64 lg:shrink-0 bg-white shadow-lg">
    <div class="p-6 border-b">
      <div class="flex items-center space-x-3">
        <div class="w-12 h-12 bg-pcc-blue rounded-full flex items-center justify-center">
          <span class="text-white font-bold text-lg">D</span>
        </div>
        <div>
          <p class="font-semibold text-gray-800"><%= user.fullName %></p>
          <p class="text-xs text-gray-500 capitalize"><%= user.role %></p>
        </div>
      </div>
    </div>

    <nav class="p-4 space-y-2">
      <a href="/dean/dashboard" class="flex items-center space-x-3 px-4 py-3 bg-pcc-blue/10 text-pcc-blue rounded-lg font-medium">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
        </svg>
        <span>Dashboard</span>
      </a>
      <a href="/dean/year-levels" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
        </svg>
        <span>Year Levels</span>
      </a>
      <a href="/dean/students" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <span>Students</span>
      </a>
      <a href="/dean/grade-entry" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
        </svg>
        <span>Grade Entry</span>
      </a>
      <a href="/dean/assignments" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
        </svg>
        <span>Assignments</span>
      </a>
      <a href="/dean/accounts" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        <span>Accounts</span>
      </a>
      <a href="/dean/reports" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
        </svg>
        <span>Reports</span>
      </a>
      <a href="/profile" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        <span>Profile</span>
      </a>
    </nav>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 min-w-0 p-4 sm:p-6 lg:p-8">
    <!-- Welcome Banner -->
    <div class="hero">
      <h1 class="text-2xl font-bold">Dean Dashboard</h1>
      <p class="mt-2 opacity-90"><%= activeSemester ? activeSemester.name + ' ' + activeSemester.school_year : 'No active semester' %></p>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <a href="/dean/students" class="panel p-6 block hover:shadow-lg transition">
        <p class="text-gray-500 text-sm">Active Students</p>
        <p class="text-3xl font-bold text-gray-800 mt-2"><%= totalStudents %></p>
        <p class="text-sm text-pcc-blue mt-2">View student list →</p>
      </a>
      <div class="panel p-6">
        <p class="text-gray-500 text-sm">Active Courses</p>
        <p class="text-3xl font-bold text-gray-800 mt-2"><%= offerings.length %></p>
      </div>
      <div class="panel p-6">
        <p class="text-gray-500 text-sm">Courses Completed</p>
        <p class="text-3xl font-bold text-green-600 mt-2">
          <%= offerings.filter(o => o.graded_count > 0).length %>
        </p>
      </div>
    </div>

    <!-- Course Offerings Progress -->
    <div class="panel mb-8">
      <div class="p-6 border-b">
        <h2 class="text-lg font-semibold text-gray-800">Course Offerings & Progress</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Course</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Section</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Students</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Progress</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% if (offerings.length > 0) { %>
              <% offerings.forEach(offering => { %>
                <tr>
                  <td class="px-6 py-4 font-medium text-gray-800"><%= offering.course_code %></td>
                  <td class="px-6 py-4 text-gray-600"><%= offering.course_name %> (Sec. <%= offering.section %>)</td>
                  <td class="px-6 py-4 text-gray-600"><%= offering.enrolled_count %></td>
                  <td class="px-6 py-4">
                    <div class="flex items-center space-x-2">
                      <div class="w-32 bg-gray-200 rounded-full h-2">
                        <div class="bg-pcc-blue rounded-full h-2" style="width: <%= offering.enrolled_count > 0 ? (offering.graded_count / offering.enrolled_count * 100) : 0 %>%"></div>
                      </div>
                      <span class="text-xs text-gray-500">
                        <%= offering.enrolled_count > 0 ? Math.round(offering.graded_count / offering.enrolled_count * 100) : 0 %>%
                      </span>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <a href="/dean/grade-entry/<%= offering.id %>" class="text-pcc-blue hover:text-pcc-blue-dark text-sm font-medium">
                      Enter Grades →
                    </a>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" class="px-6 py-8 text-center text-gray-500">No course offerings for this semester</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- At Risk Students -->
    <div class="panel">
      <div class="p-6 border-b">
        <h2 class="text-lg font-semibold text-gray-800">Students at Risk (GPA < 2.0)</h2>
      </div>
      <% if (atRiskStudents.length > 0) { %>
        <div class="divide-y divide-gray-200">
          <% atRiskStudents.forEach(s => { %>
            <div class="p-4 flex items-center justify-between">
              <div>
                <p class="font-medium text-gray-800"><%= s.first_name %> <%= s.last_name %></p>
                <p class="text-sm text-gray-500"><%= s.student_no %> | <%= s.program_code %></p>
              </div>
              <div class="flex items-center space-x-4">
                <span class="px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                  GPA: <%= Number(s.avg_gpa).toFixed(2) %>
                </span>
                <a href="/dean/prospectus/<%= s.id %>" class="text-pcc-blue hover:text-pcc-blue-dark text-sm font-medium">
                  View Prospectus →
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="p-8 text-center text-gray-500">
          No students at risk. Great job!
        </div>
      <% } %>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>