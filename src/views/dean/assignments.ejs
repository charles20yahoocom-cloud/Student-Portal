<%- include('../partials/header', { user: user }) %>
  <%- include('../partials/staff-topnav', { active: 'assignments', links: [['/dean/dashboard','Dashboard'],['/dean/year-levels','Year Levels'],['/dean/grade-entry','Grade Entry'],['/dean/assignments','Assignments'],['/dean/accounts','Accounts'],['/dean/reports','Reports'],['/profile','Profile']] }) %>

<div class="flex min-h-screen">
  <!-- Sidebar -->
  <aside class="hidden lg:flex lg:flex-col lg:w-64 lg:shrink-0 bg-white shadow-lg">
    <div class="p-6 border-b">
      <div class="flex items-center space-x-3">
        <div class="w-12 h-12 bg-pcc-blue rounded-full flex items-center justify-center">
          <span class="text-white font-bold text-lg">D</span>
        </div>
        <div>
          <p class="font-semibold text-gray-800"><%= user.fullName %></p>
          <p class="text-xs text-gray-500 capitalize"><%= user.role %></p>
        </div>
      </div>
    </div>

    <nav class="p-4 space-y-2">
      <a href="/dean/dashboard" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
        </svg>
        <span>Dashboard</span>
      </a>
      <a href="/dean/year-levels" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
        </svg>
        <span>Year Levels</span>
      </a>
      <a href="/dean/grade-entry" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
        </svg>
        <span>Grade Entry</span>
      </a>
      <a href="/dean/assignments" class="flex items-center space-x-3 px-4 py-3 bg-pcc-blue/10 text-pcc-blue rounded-lg font-medium">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
        </svg>
        <span>Assignments</span>
      </a>
      <a href="/dean/accounts" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        <span>Accounts</span>
      </a>
      <a href="/dean/reports" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
        </svg>
        <span>Reports</span>
      </a>
      <a href="/profile" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        <span>Profile</span>
      </a>
    </nav>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 min-w-0 p-4 sm:p-6 lg:p-8">
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-800">Subject Assignments</h1>
      <p class="text-gray-500 text-sm mt-1">
        Create course sections<%= activeSemester ? ' for ' + activeSemester.name + ', ' + activeSemester.school_year : '' %> and assign them to instructors.
        Assigned sections appear in the instructor's Grade Entry.
      </p>
    </div>

    <% if (success) { %>
      <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6 text-sm"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6 text-sm"><%= error %></div>
    <% } %>

    <% if (activeSemester && programs.length) { %>
      <details class="panel mb-6" <%= offerings.length ? '' : 'open' %>>
        <summary class="p-5 cursor-pointer flex items-center justify-between gap-3 select-none">
          <span class="font-semibold text-gray-800">Add a course section</span>
          <span class="text-xs text-gray-400">for <%= activeSemester.name %>, <%= activeSemester.school_year %></span>
        </summary>
        <form method="POST" action="/dean/assignments/offerings" class="px-5 pb-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Program</label>
            <select id="new-program" name="program_code" required
              class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-pcc-blue/40 focus:border-pcc-blue">
              <% if (programs.length > 1) { %>
                <option value="">Select program…</option>
              <% } %>
              <% programs.forEach(p => { %>
                <option value="<%= p.code %>" <%= programs.length === 1 ? 'selected' : '' %>><%= p.code %></option>
              <% }); %>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Course code</label>
            <input id="new-course-code" name="course_code" list="course-options" required maxlength="20" placeholder="e.g. IT 102"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pcc-blue/40 focus:border-pcc-blue outline-none">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Course title</label>
            <input id="new-course-name" name="course_name" required maxlength="120" placeholder="e.g. Fundamentals of Programming"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pcc-blue/40 focus:border-pcc-blue outline-none">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Section</label>
            <input name="section" required maxlength="10" placeholder="e.g. A"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pcc-blue/40 focus:border-pcc-blue outline-none">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Units</label>
            <input id="new-course-credits" name="credits" type="number" min="1" max="12" step="1" value="3" required
              class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pcc-blue/40 focus:border-pcc-blue outline-none">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Max enrollment <span class="text-gray-400 font-normal">(optional)</span></label>
            <input name="max_enrollment" type="number" min="1" max="500" step="1" placeholder="e.g. 40"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pcc-blue/40 focus:border-pcc-blue outline-none">
          </div>
          <div class="sm:col-span-2 lg:col-span-3">
            <button type="submit" class="inline-flex items-center justify-center gap-2 bg-pcc-blue hover:bg-pcc-blue-dark text-white font-medium px-4 py-2 rounded-lg text-sm transition">
              Add section
            </button>
            <span class="text-xs text-gray-400 ml-2">Starts unassigned — pick an instructor below.</span>
          </div>
        </form>
      </details>
      <datalist id="course-options"></datalist>
    <% } %>

    <% if (!activeSemester) { %>
      <div class="panel p-12 text-center">
        <h3 class="text-lg font-medium text-gray-800 mb-2">No Active Semester</h3>
        <p class="text-gray-500">Ask an administrator to activate a semester before assigning subjects.</p>
      </div>
    <% } else if (!offerings.length) { %>
      <div class="panel p-12 text-center">
        <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
        </svg>
        <h3 class="text-lg font-medium text-gray-800 mb-2">No Course Sections Yet</h3>
        <p class="text-gray-500">Use the <span class="font-medium">Add a course section</span> form above to create the first one.</p>
      </div>
    <% } else {
      const assigned = offerings.filter(o => o.instructor_id).length;
      const unassigned = offerings.length - assigned;
    %>
      <div class="flex flex-wrap items-center gap-2 mb-5 text-sm">
        <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-600"><%= offerings.length %> section<%= offerings.length === 1 ? '' : 's' %></span>
        <span class="px-3 py-1 rounded-full bg-green-50 text-green-700"><%= assigned %> assigned</span>
        <span class="px-3 py-1 rounded-full <%= unassigned ? 'bg-amber-50 text-amber-700' : 'bg-gray-100 text-gray-500' %>"><%= unassigned %> unassigned</span>
      </div>

      <div class="space-y-4">
        <% offerings.forEach(offering => { %>
          <div class="panel p-4 sm:p-5">
            <div class="flex flex-col lg:flex-row lg:items-center gap-4">
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-semibold text-gray-800"><%= offering.course_code %></h3>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-pcc-blue/10 text-pcc-blue">Sec. <%= offering.section %></span>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600"><%= offering.program_code %></span>
                  <% if (offering.instructor_id) { %>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-50 text-green-700">Assigned</span>
                  <% } else { %>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700">Unassigned</span>
                  <% } %>
                </div>
                <p class="text-sm text-gray-500 mt-1"><%= offering.course_name %></p>
                <p class="text-xs text-gray-400 mt-1">
                  <%= offering.enrolled_count %> students
                  <% if (offering.instructor_name) { %>
                    &middot; Currently <span class="font-medium text-gray-600"><%= offering.instructor_name %></span>
                  <% } else { %>
                    &middot; No instructor yet
                  <% } %>
                </p>
              </div>

              <div class="shrink-0 flex flex-col items-stretch lg:items-end gap-2">
                <form action="/dean/assignments/<%= offering.id %>" method="POST" class="flex flex-col sm:flex-row sm:items-center gap-2">
                  <label class="sr-only" for="instructor-<%= offering.id %>">Instructor for <%= offering.course_code %> Sec. <%= offering.section %></label>
                  <select id="instructor-<%= offering.id %>" name="instructor_id" class="w-full sm:w-64 px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-pcc-blue/40 focus:border-pcc-blue">
                    <option value="">— Unassigned —</option>
                    <% faculty.forEach(f => { %>
                      <option value="<%= f.id %>" <%= offering.instructor_id === f.id ? 'selected' : '' %>><%= f.full_name %> (<%= f.email %>)</option>
                    <% }); %>
                  </select>
                  <button type="submit" class="inline-flex items-center justify-center gap-2 bg-pcc-blue hover:bg-pcc-blue-dark text-white font-medium px-4 py-2 rounded-lg text-sm transition">
                    Save
                  </button>
                </form>
                <% if (offering.enrolled_count > 0) { %>
                  <span class="text-[11px] text-gray-400 text-left lg:text-right">Has enrolled students — cannot be deleted</span>
                <% } else { %>
                  <form action="/dean/assignments/offerings/<%= offering.id %>/delete" method="POST" class="text-left lg:text-right"
                    onsubmit="return confirm('Delete <%= offering.course_code %> Sec. <%= offering.section %>? This cannot be undone.');">
                    <button type="submit" class="text-xs text-red-500 hover:text-red-700 font-medium">Delete section</button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>

      <p class="text-xs text-gray-400 mt-6">
        Tip: choose &ldquo;Unassigned&rdquo; and press Save to remove an instructor from a section.
      </p>
    <% } %>
  </main>
</div>

<script>
  (function () {
    const courses = <%- JSON.stringify(curriculumCourses).replace(/</g, '\\u003c') %>;
    const program = document.getElementById('new-program');
    const list = document.getElementById('course-options');
    const code = document.getElementById('new-course-code');
    const name = document.getElementById('new-course-name');
    const credits = document.getElementById('new-course-credits');
    if (!program || !list || !code) return;

    function refreshList() {
      list.innerHTML = '';
      const p = program.value;
      courses.filter(c => !p || c.program_code === p).forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.code;
        opt.label = c.name + ' (' + c.credits + ' units)';
        list.appendChild(opt);
      });
    }

    function fillFromCode() {
      const c = courses.find(x => x.code.toUpperCase() === code.value.trim().toUpperCase());
      if (c) {
        name.value = c.name;
        credits.value = c.credits;
      }
    }

    program.addEventListener('change', refreshList);
    code.addEventListener('input', fillFromCode);
    code.addEventListener('change', fillFromCode);
    refreshList();
  })();
</script>

<%- include('../partials/footer') %>
