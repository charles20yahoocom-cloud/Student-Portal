<%- include('../partials/header', { user: user }) %>
  <%- include('../partials/staff-topnav', { active: 'year-levels', links: [['/dean/dashboard','Dashboard'],['/dean/year-levels','Year Levels'],['/dean/grade-entry','Grade Entry'],['/dean/assignments','Assignments'],['/dean/accounts','Accounts'],['/dean/reports','Reports'],['/profile','Profile']] }) %>

<div class="flex min-h-screen">
  <!-- Sidebar -->
  <aside class="hidden lg:flex lg:flex-col lg:w-64 lg:shrink-0 bg-white shadow-lg">
    <div class="p-6 border-b">
      <div class="flex items-center space-x-3">
        <div class="w-12 h-12 bg-pcc-blue rounded-full flex items-center justify-center">
          <span class="text-white font-bold text-lg">D</span>
        </div>
        <div>
          <p class="font-semibold text-gray-800"><%= user.fullName %></p>
          <p class="text-xs text-gray-500 capitalize"><%= user.role %></p>
        </div>
      </div>
    </div>

    <nav class="p-4 space-y-2">
      <a href="/dean/dashboard" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
        </svg>
        <span>Dashboard</span>
      </a>
      <a href="/dean/year-levels" class="flex items-center space-x-3 px-4 py-3 bg-pcc-blue/10 text-pcc-blue rounded-lg font-medium">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
        </svg>
        <span>Year Levels</span>
      </a>
      <a href="/dean/grade-entry" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
        </svg>
        <span>Grade Entry</span>
      </a>
      <a href="/dean/assignments" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
        </svg>
        <span>Assignments</span>
      </a>
      <a href="/dean/accounts" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        <span>Accounts</span>
      </a>
      <a href="/dean/reports" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
        </svg>
        <span>Reports</span>
      </a>
      <a href="/profile" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        <span>Profile</span>
      </a>
    </nav>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 min-w-0 p-4 sm:p-6 lg:p-8">
    <a href="/dean/year-levels" class="inline-flex items-center text-pcc-blue hover:text-pcc-blue-dark mb-4 font-medium">
      &larr; All Year Levels
    </a>

    <div class="hero">
      <h1 class="text-2xl font-bold">Year <%= year %></h1>
      <p class="mt-2 opacity-90"><%= programName || 'Select a program' %></p>
    </div>

    <% if (programs.length > 1) { %>
      <div class="flex flex-wrap gap-2 mt-4">
        <% programs.forEach(p => { %>
          <a href="/dean/year-levels/<%= year %>?program=<%= encodeURIComponent(p.program_code) %>"
             class="px-4 py-2 rounded-lg text-sm font-medium transition <%= p.program_code === activeProgram ? 'text-white' : 'text-gray-600 bg-white border' %>"
             style="<%= p.program_code === activeProgram ? 'background:linear-gradient(135deg,#2A5BD7,#16307F); border:1px solid rgba(212,175,55,.4);' : '' %>">
            <%= p.program_code %>
          </a>
        <% }) %>
      </div>
    <% } %>

    <!-- Year summary -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-6 mb-8">
      <div class="panel p-4 text-center">
        <p class="text-2xl font-bold text-royal-900"><%= sem1.length + sem2.length %></p>
        <p class="text-xs text-gray-500 mt-1">Required Subjects</p>
      </div>
      <div class="panel p-4 text-center">
        <p class="text-2xl font-bold text-royal-900"><%= (sem1.reduce((a, c) => a + c.credits, 0) + sem2.reduce((a, c) => a + c.credits, 0)) %></p>
        <p class="text-xs text-gray-500 mt-1">Total Units</p>
      </div>
      <div class="panel p-4 text-center">
        <p class="text-2xl font-bold text-royal-900"><%= yearStat.student_count %></p>
        <p class="text-xs text-gray-500 mt-1">Enrolled Students</p>
      </div>
      <div class="panel p-4 text-center">
        <p class="text-2xl font-bold text-royal-900"><%= sections.length %></p>
        <p class="text-xs text-gray-500 mt-1">Sections</p>
      </div>
    </div>

    <!-- Subjects required -->
    <% if (activeProgram) { %>
      <div class="panel mb-8">
        <div class="p-6 border-b">
          <h2 class="text-lg font-semibold text-royal-900">Subjects Required &mdash; Year <%= year %></h2>
          <p class="text-sm text-gray-500 mt-1"><%= activeProgram %> &middot; <%= programName %></p>
        </div>

        <% if (sem1.length === 0 && sem2.length === 0) { %>
          <div class="p-10 text-center text-gray-400">No curriculum items for this year level.</div>
        <% } else { %>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 p-6">
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-wide text-gray-400 mb-3">1st Semester</h3>
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b-2 text-left" style="border-color:#D4AF37;">
                    <th class="py-2 pr-2 text-gray-500 font-semibold">Code</th>
                    <th class="py-2 pr-2 text-gray-500 font-semibold">Subject</th>
                    <th class="py-2 text-right text-gray-500 font-semibold">Units</th>
                  </tr>
                </thead>
                <tbody>
                  <% sem1.forEach(c => { %>
                    <tr class="border-b">
                      <td class="py-2.5 pr-2 font-mono text-pcc-blue"><%= c.course_code %></td>
                      <td class="py-2.5 pr-2 text-gray-700"><%= c.course_name %></td>
                      <td class="py-2.5 text-right text-gray-600"><%= c.credits %></td>
                    </tr>
                  <% }) %>
                  <tr class="font-semibold text-royal-900">
                    <td class="py-2.5 pr-2" colspan="2">Semester Total</td>
                    <td class="py-2.5 text-right"><%= sem1.reduce((a, c) => a + c.credits, 0) %></td>
                  </tr>
                </tbody>
              </table>
            </div>
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-wide text-gray-400 mb-3">2nd Semester</h3>
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b-2 text-left" style="border-color:#D4AF37;">
                    <th class="py-2 pr-2 text-gray-500 font-semibold">Code</th>
                    <th class="py-2 pr-2 text-gray-500 font-semibold">Subject</th>
                    <th class="py-2 text-right text-gray-500 font-semibold">Units</th>
                  </tr>
                </thead>
                <tbody>
                  <% sem2.forEach(c => { %>
                    <tr class="border-b">
                      <td class="py-2.5 pr-2 font-mono text-pcc-blue"><%= c.course_code %></td>
                      <td class="py-2.5 pr-2 text-gray-700"><%= c.course_name %></td>
                      <td class="py-2.5 text-right text-gray-600"><%= c.credits %></td>
                    </tr>
                  <% }) %>
                  <tr class="font-semibold text-royal-900">
                    <td class="py-2.5 pr-2" colspan="2">Semester Total</td>
                    <td class="py-2.5 text-right"><%= sem2.reduce((a, c) => a + c.credits, 0) %></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>

    <!-- Sections -->
    <div class="panel">
      <div class="p-6 border-b">
        <h2 class="text-lg font-semibold text-royal-900">Sections &mdash; Year <%= year %></h2>
        <p class="text-sm text-gray-500 mt-1"><%= yearStat.student_count %> student(s) in <%= sections.length %> section(s)</p>
      </div>

      <div class="p-6">
        <% if (sections.length === 0 && unassigned === 0) { %>
          <div class="text-center text-gray-400 py-6">No students in this year level yet.</div>
        <% } else { %>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <% sections.forEach(s => { %>
              <div class="rounded-xl border overflow-hidden">
                <div class="px-5 py-4 flex items-center justify-between" style="background:linear-gradient(135deg,rgba(30,66,159,.08),rgba(212,175,55,.12));">
                  <div>
                    <h3 class="font-display text-lg font-bold text-royal-900">Section <%= s.section %></h3>
                    <p class="text-xs text-gray-500"><%= s.student_count %> student(s)</p>
                  </div>
                  <span class="px-3 py-1 rounded-full text-xs font-semibold" style="background:rgba(212,175,55,.18); color:#8a6d1a;">Year <%= year %></span>
                </div>
                <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <tbody>
                    <% s.students.forEach(st => { %>
                      <tr class="border-t">
                        <td class="px-5 py-2.5 font-mono text-gray-500 whitespace-nowrap"><%= st.student_no %></td>
                        <td class="px-5 py-2.5 text-gray-700"><%= st.full_name %></td>
                        <td class="px-5 py-2.5 text-xs text-gray-400 capitalize"><%= st.gender || '&ndash;' %></td>
                        <td class="px-5 py-2.5 text-right whitespace-nowrap"><a href="/dean/prospectus/<%= st.id %>" class="text-pcc-blue hover:text-pcc-blue-dark text-sm font-medium">View Prospectus →</a></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
                </div>
              </div>
            <% }) %>

            <% if (unassigned > 0) { %>
              <div class="rounded-xl border border-dashed overflow-hidden">
                <div class="px-5 py-4 flex items-center justify-between" style="background:rgba(239,68,68,.06);">
                  <div>
                    <h3 class="font-display text-lg font-bold text-gray-600">Unassigned</h3>
                    <p class="text-xs text-gray-500"><%= unassigned %> student(s) without a section</p>
                  </div>
                </div>
                <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <tbody>
                    <% unassignedStudents.forEach(st => { %>
                      <tr class="border-t">
                        <td class="px-5 py-2.5 font-mono text-gray-500 whitespace-nowrap"><%= st.student_no %></td>
                        <td class="px-5 py-2.5 text-gray-700"><%= st.full_name %></td>
                        <td class="px-5 py-2.5 text-xs text-gray-400 capitalize"><%= st.gender || '&ndash;' %></td>
                        <td class="px-5 py-2.5 text-right whitespace-nowrap"><a href="/dean/prospectus/<%= st.id %>" class="text-pcc-blue hover:text-pcc-blue-dark text-sm font-medium">View Prospectus →</a></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>