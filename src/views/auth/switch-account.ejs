<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= title %></title>
  <link href="/css/fonts.css" rel="stylesheet">
  <script src="/js/tailwind.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'pcc-blue': '#1E429F',
            'pcc-blue-dark': '#16307F',
            'pcc-gold': '#D4AF37',
            'royal-900': '#0B1747',
            'royal-800': '#10215F',
            'gold-400': '#EFD27A',
            'gold-500': '#D4AF37',
          },
          fontFamily: {
            sans: ['Inter', "'Segoe UI'", 'system-ui', 'sans-serif'],
            display: ['"Playfair Display"', 'Georgia', 'serif'],
          }
        }
      }
    }
  </script>
  <style>
    body {
      font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
      background-color: #0B1747;
      background-image:
        radial-gradient(900px 500px at 85% -10%, rgba(212, 175, 55, 0.18), transparent 60%),
        radial-gradient(1100px 600px at -15% 110%, rgba(30, 66, 159, 0.36), transparent 60%);
    }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md rounded-2xl shadow-2xl border border-white/50 bg-white/95 backdrop-blur p-6 sm:p-8 text-center">
    <img src="/images/pcc-logo.jpg" alt="Passi City College logo"
         class="w-14 h-14 rounded-full object-cover mx-auto mb-4 ring-4 ring-gold-400/50 shadow-lg">

    <p class="text-[11px] font-semibold tracking-[0.2em] text-pcc-blue uppercase mb-2">Switch accounts</p>
    <h1 class="font-display text-xl font-bold text-royal-900 leading-snug">
      You're signed in as <%= name %>
    </h1>
    <p class="text-sm text-gray-600 mt-2">
      Account type: <span class="font-semibold capitalize text-gray-800"><%= role %></span><br>
      <% if (typeof note !== 'undefined' && note) { %>
        <%= note %>
      <% } else { %>
        This is the <span class="font-semibold text-gray-800"><%= door %></span> entrance,
        which needs a different account.
      <% } %>
    </p>

    <div class="mt-6 space-y-3">
      <a href="<%= home %>"
         class="flex w-full items-center justify-center gap-2 rounded-lg bg-pcc-gold hover:brightness-95 font-semibold px-4 py-2.5 transition"
         style="color:#0B1747;">
        Go to my <%= role %> portal
      </a>
      <a href="/auth/logout?next=<%= doorPath %>"
         class="flex w-full items-center justify-center gap-2 rounded-lg border border-pcc-blue/50 bg-white hover:bg-pcc-blue/5 text-pcc-blue font-semibold px-4 py-2.5 transition">
        Sign out &amp; switch to <%= door %>
      </a>
    </div>

    <div class="mt-6 pt-4 border-t border-gray-200 text-left">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Portal entrances</p>
      <ul class="text-sm space-y-1.5">
        <li><a href="/login" class="text-pcc-blue hover:text-pcc-blue-dark">Students</a> <span class="text-gray-400">/login</span></li>
        <li><a href="/instructor" class="text-pcc-blue hover:text-pcc-blue-dark">Teachers</a> <span class="text-gray-400">/instructor</span></li>
        <li><a href="/dean" class="text-pcc-blue hover:text-pcc-blue-dark">Dean / Admin</a> <span class="text-gray-400">/dean</span></li>
      </ul>
    </div>
  </div>
</body>
</html>
