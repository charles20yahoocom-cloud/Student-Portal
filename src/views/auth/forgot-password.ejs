<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="/css/fonts.css" rel="stylesheet">
  <script src="/js/tailwind.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'pcc-blue': '#1E429F',
            'pcc-blue-dark': '#16307F',
            'pcc-gold': '#D4AF37',
            'pcc-ink': '#070E2E',
            'royal-900': '#0B1747',
            'royal-800': '#10215F',
            'gold-300': '#F7E7A6',
            'gold-400': '#EFD27A',
            'gold-500': '#D4AF37',
            'gold-600': '#B8912B',
          },
          fontFamily: {
            sans: ['Inter', "'Segoe UI'", 'system-ui', 'sans-serif'],
            display: ['"Playfair Display"', 'Georgia', 'serif'],
          }
        }
      }
    }
  </script>
  <style>
    /* Keep iOS Safari from auto-zooming on input focus */
    @media (max-width: 640px) {
      input, select, textarea { font-size: 16px !important; }
    }
    .bg-grid {
      background-image:
        linear-gradient(rgba(30, 66, 159, 0.09) 1px, transparent 1px),
        linear-gradient(90deg, rgba(30, 66, 159, 0.09) 1px, transparent 1px);
      background-size: 42px 42px;
      animation: gridScroll 18s linear infinite;
    }
    @keyframes gridScroll {
      from { background-position: 0 0; }
      to   { background-position: 0 42px; }
    }
    .orb { border-radius: 9999px; filter: blur(70px); opacity: 0.5; }
    .card-in { animation: cardIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.05s both; }
    @keyframes cardIn {
      from { opacity: 0; transform: translateY(22px) scale(0.97); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    @media (prefers-reduced-motion: reduce) {
      .bg-grid, .orb, .card-in { animation: none; }
    }
  </style>
</head>
<body class="bg-pcc-ink min-h-screen flex p-4 relative overflow-x-hidden overflow-y-auto">

  <div class="fixed inset-0 bg-grid pointer-events-none"></div>
  <div class="fixed inset-0 pointer-events-none">
    <div class="orb w-[440px] h-[440px] bg-pcc-blue/40 -top-24 -left-24"></div>
    <div class="orb w-[420px] h-[420px] bg-pcc-gold/20 bottom-0 -right-32"></div>
  </div>

  <%
    const stepVal = (typeof step !== 'undefined' && step) ? step : 1;
    const emailVal = (typeof email !== 'undefined' && email) ? email : '';
    const errorVal = (typeof error !== 'undefined') ? error : null;
    const noticeVal = (typeof notice !== 'undefined') ? notice : null;
    const sentVal = (typeof sent !== 'undefined') ? sent : false;
  %>

  <div class="relative z-10 w-full max-w-sm m-auto py-6">
    <div class="card-in w-full bg-white/90 backdrop-blur-md rounded-2xl shadow-2xl border border-white/40 p-6">

      <div class="flex items-center gap-3.5 mb-5">
        <div class="shrink-0 w-12 h-12 rounded-full bg-gradient-to-br from-pcc-blue via-pcc-blue-dark to-pcc-blue ring-4 ring-pcc-gold/70 flex items-center justify-center">
          <div class="w-[42px] h-[42px] rounded-full border border-white/40 flex items-center justify-center">
            <span class="text-white text-sm font-bold">PCC</span>
          </div>
        </div>
        <div>
          <h1 class="font-display text-xl font-bold text-royal-900">Forgot Password</h1>
          <p class="text-xs text-gray-500"><%= stepVal === 1 ? 'Student account recovery' : 'Step 2 of 2 — verify & reset' %></p>
        </div>
      </div>

      <% if (errorVal) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4 text-sm">
          <%= errorVal %>
        </div>
      <% } %>
      <% if (noticeVal) { %>
        <div class="bg-blue-50 border border-blue-200 text-pcc-blue px-4 py-3 rounded-lg mb-4 text-sm">
          <%= noticeVal %>
        </div>
      <% } %>

      <% if (stepVal === 1) { %>

        <p class="text-sm text-gray-600 mb-4 leading-snug">
          Enter your <strong>student email</strong> and we'll send you a 6-digit verification code to confirm it's you.
        </p>

        <form action="/forgot-password" method="POST" class="space-y-3.5">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Student Email</label>
            <input
              type="email"
              name="email"
              required
              value="<%= emailVal %>"
              placeholder="student.email@pcc.edu.ph"
              class="w-full px-3.5 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-pcc-blue focus:border-transparent outline-none transition text-sm"
            >
          </div>
          <button
            type="submit"
            class="w-full bg-gradient-to-r from-pcc-blue-dark via-pcc-blue to-pcc-blue-dark hover:to-pcc-gold/80 text-white font-semibold py-2.5 rounded-lg shadow-lg transition duration-200"
          >
            Send Verification Code
          </button>
        </form>

        <p class="text-xs text-gray-500 mt-4 text-center leading-snug">
          Faculty or Dean? Please contact the IT/Accounts office instead.
        </p>

      <% } else { %>

        <% if (sentVal) { %>
          <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-4 text-sm">
            We sent a 6-digit code to <strong><%= emailVal %></strong>.
          </div>
        <% } %>

        <form action="/forgot-password/verify" method="POST" class="space-y-3.5">
          <input type="hidden" name="email" value="<%= emailVal %>">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Verification Code</label>
            <input
              type="text"
              name="code"
              required
              inputmode="numeric"
              autocomplete="one-time-code"
              maxlength="6"
              pattern="[0-9]{6}"
              placeholder="000000"
              class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-pcc-blue focus:border-transparent outline-none transition text-center text-xl font-bold tracking-[0.45em] font-mono"
            >
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">New Password</label>
            <input
              type="password"
              name="password"
              required
              minlength="8"
              placeholder="At least 8 characters"
              class="w-full px-3.5 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-pcc-blue focus:border-transparent outline-none transition text-sm"
            >
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Confirm New Password</label>
            <input
              type="password"
              name="confirm"
              required
              minlength="8"
              placeholder="Repeat the new password"
              class="w-full px-3.5 py-2 bg-gray-50 border border-gray-200 rounded-lg focus:ring-2 focus:ring-pcc-blue focus:border-transparent outline-none transition text-sm"
            >
          </div>
          <button
            type="submit"
            class="w-full bg-gradient-to-r from-pcc-blue-dark via-pcc-blue to-pcc-blue-dark hover:to-pcc-gold/80 text-white font-semibold py-2.5 rounded-lg shadow-lg transition duration-200"
          >
            Verify &amp; Reset Password
          </button>
        </form>

        <form action="/forgot-password" method="POST" class="mt-3 text-center">
          <input type="hidden" name="email" value="<%= emailVal %>">
          <button type="submit" class="text-xs text-pcc-blue hover:underline">Didn't get the code? Resend it</button>
        </form>

      <% } %>

      <div class="mt-4 pt-3 border-t border-gray-200 text-center">
        <a href="/login" class="text-sm text-pcc-blue hover:underline font-medium">&larr; Back to Login</a>
      </div>
    </div>
  </div>
</body>
</html>
