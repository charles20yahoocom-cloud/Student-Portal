<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= title %></title>
  <link href="/css/fonts.css" rel="stylesheet">
  <script src="/js/tailwind.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'pcc-blue': '#1E429F',
            'pcc-blue-dark': '#16307F',
            'pcc-gold': '#D4AF37',
            'royal-950': '#070E2E',
            'royal-900': '#0B1747',
            'royal-800': '#10215F',
            'royal-700': '#16307F',
            'royal-600': '#1E429F',
            'navy-950': '#070E2E',
            'navy-900': '#0B1747',
            'navy-800': '#10215F',
            'navy-700': '#16307F',
            'navy-600': '#1E429F',
            'gold-300': '#F7E7A6',
            'gold-400': '#EFD27A',
            'gold-500': '#D4AF37',
            'gold-600': '#B8912B',
            'gold-700': '#8C6D1F',
          },
          fontFamily: {
            sans: ['Inter', "'Segoe UI'", 'system-ui', 'sans-serif'],
            display: ['"Playfair Display"', 'Georgia', 'serif'],
          }
        }
      }
    }
  </script>
  <style>
    /* Keep iOS Safari from auto-zooming on input focus */
    @media (max-width: 640px) {
      input, select, textarea { font-size: 16px !important; }
    }
    body {
      font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
      -webkit-font-smoothing: antialiased;
      background-color: #0B1747;
      background-image:
        radial-gradient(900px 500px at 85% -10%, rgba(212, 175, 55, 0.18), transparent 60%),
        radial-gradient(1100px 600px at -15% 110%, rgba(30, 66, 159, 0.36), transparent 60%),
        radial-gradient(700px 420px at 105% 90%, rgba(30, 66, 159, 0.26), transparent 55%),
        linear-gradient(160deg, #10215F 0%, #0B1747 50%, #070E2E 100%);
      background-attachment: fixed;
    }
    ::selection { background: rgba(212, 175, 55, 0.4); color: #0B1747; }
    .glass-card {
      position: relative;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.5);
      border-radius: 1.6rem;
      box-shadow: 0 24px 60px -20px rgba(4, 10, 26, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.12);
    }
    .glass-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 10%;
      right: 10%;
      height: 3px;
      border-radius: 0 0 6px 6px;
      background: linear-gradient(90deg, transparent, #EFD27A, #D4AF37 70%, transparent);
    }
    input, select {
      border-radius: 0.8rem;
      transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }
    input:focus, select:focus {
      border-color: #1E429F !important;
      box-shadow: 0 0 0 4px rgba(30, 66, 159, 0.16);
      outline: none;
    }
    input::placeholder { color: #9aa4bd; }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center p-3 sm:p-6">
  <div class="glass-card p-5 sm:p-7 w-full max-w-md">

    <!-- Logo & Title -->
    <div class="text-center mb-5">
      <img src="/images/pcc-logo.jpg" alt="Passi City College logo"
           class="w-14 h-14 rounded-full object-cover mx-auto mb-3 ring-4 ring-gold-400/50 shadow-[0_10px_24px_-8px_rgba(212,175,55,0.7)]">
      <h1 class="font-display text-xl font-bold text-navy-900">Student Registration</h1>
      <p class="text-sm mt-1 text-navy-600/70">Passi City College</p>
      <div class="mt-3 mx-auto max-w-sm flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-[11px] leading-snug"
           style="background: rgba(212,175,55,.14); color: #8a6d1c;">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        Account takes effect after the Dean approves your registration.
      </div>
    </div>

    <!-- Error Message -->
    <% if (error) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-2.5 rounded-xl mb-4 text-sm flex items-start gap-2">
        <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <!-- Registration Form -->
    <form action="/register" method="POST" enctype="multipart/form-data" class="space-y-3">
      <!-- Profile Photo -->
      <div class="flex items-center gap-4 p-3 rounded-2xl mb-1"
           style="background: rgba(20,32,62,.04); border: 1px solid rgba(20,32,62,.07);">
        <div class="relative w-[72px] h-[72px] shrink-0 rounded-full overflow-hidden flex items-center justify-center"
             style="background: linear-gradient(135deg,#eef2fa,#e2e8f6); border: 2px solid rgba(212,175,55,.6);">
          <svg id="photoPlaceholder" class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          <img id="photoImg" alt="Profile preview" class="hidden w-full h-full object-cover">
        </div>

        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium text-navy-800">Profile Photo <span class="text-xs font-normal text-gray-400">(optional)</span></p>
          <div class="flex flex-wrap gap-2 mt-1.5">
            <button type="button" onclick="pickPhoto()"
              class="px-3 py-1.5 rounded-lg text-xs font-semibold text-white transition hover:brightness-110"
              style="background: linear-gradient(135deg,#1E429F,#16307F); box-shadow: 0 8px 16px -8px rgba(22,48,127,.7);">
              Choose Photo
            </button>
            <button type="button" onclick="openSelfie()"
              class="px-3 py-1.5 rounded-lg text-xs font-semibold transition"
              style="background: linear-gradient(135deg,#EFD27A,#D4AF37); color:#10215F; box-shadow: 0 8px 16px -8px rgba(212,175,55,.8);">
              Take Selfie
            </button>
            <button type="button" id="clearPhotoBtn" onclick="clearPhoto()" class="hidden px-3 py-1.5 rounded-lg text-xs font-semibold text-red-600 border border-red-200 bg-red-50 hover:bg-red-100 transition">
              Remove
            </button>
          </div>
          <p id="photoHint" class="text-[11px] leading-snug mt-1.5" style="color:#8b93a8;">
            JPG, PNG or WebP · max 5MB. Photos are downscaled automatically.
          </p>
        </div>
      </div>

      <input type="file" id="pictureInput" name="picture" accept="image/jpeg,image/png,image/webp" class="hidden">
      <div>
        <label class="block text-sm font-medium text-navy-800 mb-1.5">Student ID Number</label>
        <input type="text" name="studentNo" required placeholder="e.g. 2026-0001"
          value="<%= form && form.studentNo ? form.studentNo : '' %>"
          class="w-full px-3.5 py-2.5 border border-gray-200 bg-white/90 shadow-sm">
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-sm font-medium text-navy-800 mb-1.5">First Name</label>
          <input type="text" name="firstName" required placeholder="Juan"
            value="<%= form && form.firstName ? form.firstName : '' %>"
            class="w-full px-3.5 py-2.5 border border-gray-200 bg-white/90 shadow-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-navy-800 mb-1.5">Last Name</label>
          <input type="text" name="lastName" required placeholder="Dela Cruz"
            value="<%= form && form.lastName ? form.lastName : '' %>"
            class="w-full px-3.5 py-2.5 border border-gray-200 bg-white/90 shadow-sm">
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-navy-800 mb-1.5">Program</label>
        <select name="programCode" required
          class="w-full px-3.5 py-2.5 border border-gray-200 bg-white/90 shadow-sm">
          <option value="">Select program...</option>
          <% programs.forEach(p => { %>
            <option value="<%= p.code %>"
              <%= form && form.programCode === p.code ? 'selected' : '' %>>
              <%= p.code %> - <%= p.name %>
            </option>
          <% }); %>
        </select>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-sm font-medium text-navy-800 mb-1.5">Year Level</label>
          <select name="yearLevel" required
            class="w-full px-3.5 py-2.5 border border-gray-200 bg-white/90 shadow-sm">
            <option value="">Select year...</option>
            <% [1, 2, 3, 4].forEach(y => { %>
              <option value="<%= y %>"
                <%= form && Number(form.yearLevel) === y ? 'selected' : '' %>>
                <%= y %>st/rd/<%= y %> Year
              </option>
            <% }); %>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-navy-800 mb-1.5">Section</label>
          <input type="text" name="section" required placeholder="e.g. 1A"
            value="<%= form && form.section ? form.section : '' %>"
            class="w-full px-3.5 py-2.5 border border-gray-200 bg-white/90 shadow-sm">
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-navy-800 mb-1.5">Email Address</label>
        <input type="email" name="email" required placeholder="your.email@pcc.edu.ph"
          value="<%= form && form.email ? form.email : '' %>"
          class="w-full px-3.5 py-2.5 border border-gray-200 bg-white/90 shadow-sm">
      </div>

      <div>
        <label class="block text-sm font-medium text-navy-800 mb-1.5">Password</label>
        <input type="password" name="password" required placeholder="Create a password (min. 8 characters)"
          class="w-full px-3.5 py-2.5 border border-gray-200 bg-white/90 shadow-sm">
      </div>

      <button type="submit"
        class="w-full font-semibold py-2.5 rounded-xl transition duration-200 hover:brightness-105 active:scale-[.99] shadow-[0_12px_26px_-10px_rgba(212,175,55,0.8)]"
        style="background: linear-gradient(135deg, #EFD27A, #D4AF37); color: #10215F;">
        Register
      </button>
    </form>

    <!-- Footer -->
    <div class="mt-5 text-center text-[13px] text-navy-600/70">
      <p>Already have an account?
        <a href="/login" class="font-semibold hover:underline" style="color: #16307F;">Sign in</a>
      </p>
    </div>
  </div>

  <!-- Selfie Camera Modal -->
  <div id="selfieModal" class="hidden fixed inset-0 z-[70] items-center justify-center p-4"
       style="background: rgba(6,11,24,.72); backdrop-filter: blur(6px);">
    <div class="glass-card p-5 w-full max-w-sm">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-base font-bold text-navy-900">Take a Selfie</h2>
        <button type="button" onclick="closeSelfie()" aria-label="Close"
          class="w-8 h-8 rounded-full flex items-center justify-center text-navy-700 hover:bg-gray-100 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="rounded-2xl overflow-hidden bg-navy-950" style="aspect-ratio: 1 / 1;">
        <video id="selfieVideo" autoplay playsinline muted class="w-full h-full object-cover -scale-x-100"></video>
      </div>
      <p id="selfieError" class="hidden text-xs text-red-600 mt-2 text-center"></p>
      <div class="flex gap-2 mt-4">
        <button type="button" onclick="closeSelfie()"
          class="flex-1 py-2.5 rounded-xl text-sm font-semibold text-navy-700 border border-navy-800/20 hover:bg-gray-50 transition">
          Cancel
        </button>
        <button type="button" onclick="captureSelfie()"
          class="flex-1 py-2.5 rounded-xl text-sm font-semibold transition hover:brightness-105 active:scale-[.99]"
          style="background: linear-gradient(135deg,#EFD27A,#D4AF37); color:#10215F;">
          Capture
        </button>
      </div>
    </div>
  </div>
</body>

<script>
  const MAX_BYTES = 5 * 1024 * 1024;
  const ALLOWED = ['image/jpeg', 'image/png', 'image/webp'];
  const photoInput = document.getElementById('pictureInput');
  const photoImg = document.getElementById('photoImg');
  const photoPlaceholder = document.getElementById('photoPlaceholder');
  const clearPhotoBtn = document.getElementById('clearPhotoBtn');
  const photoHint = document.getElementById('photoHint');
  const selfieModal = document.getElementById('selfieModal');
  const selfieVideo = document.getElementById('selfieVideo');
  const selfieError = document.getElementById('selfieError');
  let selfieStream = null;

  function resetHint(text, isError) {
    photoHint.textContent = text;
    photoHint.style.color = isError ? '#dc2626' : '#8b93a8';
  }

  function pickPhoto() {
    photoInput.removeAttribute('capture');
    photoInput.click();
  }

  // Downscale to a square (max 480px) JPEG so uploads stay small
  function shrinkToSquare(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => {
        const img = new Image();
        img.onload = () => {
          const size = Math.min(img.width, img.height);
          const canvas = document.createElement('canvas');
          canvas.width = canvas.height = Math.min(size, 480);
          const ctx = canvas.getContext('2d');
          ctx.drawImage(
            img,
            (img.width - size) / 2, (img.height - size) / 2, size, size,
            0, 0, canvas.width, canvas.height
          );
          canvas.toBlob((blob) => {
            if (blob) resolve(new File([blob], 'photo.jpg', { type: 'image/jpeg' }));
            else reject(new Error('resize failed'));
          }, 'image/jpeg', 0.85);
        };
        img.onerror = reject;
        img.src = reader.result;
      };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  function showPreview(objectUrl) {
    photoImg.src = objectUrl;
    photoImg.classList.remove('hidden');
    photoPlaceholder.classList.add('hidden');
    clearPhotoBtn.classList.remove('hidden');
  }

  async function attachFile(file) {
    try {
      const small = await shrinkToSquare(file);
      const dt = new DataTransfer();
      dt.items.add(small);
      photoInput.files = dt.files;
      showPreview(URL.createObjectURL(small));
      resetHint('Photo attached · JPG, PNG or WebP · max 5MB.', false);
    } catch (e) {
      resetHint('That image could not be processed. Try a different photo.', true);
    }
  }

  photoInput.addEventListener('change', () => {
    const file = photoInput.files && photoInput.files[0];
    if (!file) return;
    if (!ALLOWED.includes(file.type)) {
      clearPhoto();
      resetHint('Please choose a JPG, PNG, or WebP image.', true);
      return;
    }
    if (file.size > MAX_BYTES) {
      clearPhoto();
      resetHint('That photo is too large (max 5MB). Please pick a smaller one.', true);
      return;
    }
    attachFile(file);
  });

  function clearPhoto() {
    photoInput.value = '';
    photoImg.classList.add('hidden');
    photoImg.removeAttribute('src');
    photoPlaceholder.classList.remove('hidden');
    clearPhotoBtn.classList.add('hidden');
    resetHint('JPG, PNG or WebP · max 5MB. Photos are downscaled automatically.', false);
  }

  async function openSelfie() {
    selfieError.classList.add('hidden');
    selfieModal.classList.remove('hidden');
    selfieModal.style.display = 'flex';

    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      selfieError.textContent = 'Live camera is not available here — use “Choose Photo” instead.';
      selfieError.classList.remove('hidden');
      return;
    }

    try {
      selfieStream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: 'user', width: { ideal: 720 }, height: { ideal: 720 } },
        audio: false
      });
      selfieVideo.srcObject = selfieStream;
    } catch (e) {
      selfieError.textContent = 'Camera blocked or unavailable. Use “Choose Photo”, or allow camera access and try again.';
      selfieError.classList.remove('hidden');
    }
  }

  function closeSelfie() {
    if (selfieStream) {
      selfieStream.getTracks().forEach((t) => t.stop());
      selfieStream = null;
    }
    selfieVideo.srcObject = null;
    selfieModal.classList.add('hidden');
    selfieModal.style.display = 'none';
  }

  function captureSelfie() {
    const video = selfieVideo;
    if (!video.videoWidth) {
      selfieError.textContent = 'Camera is not ready yet. Please wait a moment and try again.';
      selfieError.classList.remove('hidden');
      return;
    }
    const size = Math.min(video.videoWidth, video.videoHeight);
    const canvas = document.createElement('canvas');
    canvas.width = canvas.height = Math.min(size, 480);
    const ctx = canvas.getContext('2d');
    // Mirror horizontally so the selfie looks like a mirror reflection
    ctx.translate(canvas.width, 0);
    ctx.scale(-1, 1);
    ctx.drawImage(
      video,
      (video.videoWidth - size) / 2, (video.videoHeight - size) / 2, size, size,
      0, 0, canvas.width, canvas.height
    );

    canvas.toBlob((blob) => {
      if (!blob) {
        selfieError.textContent = 'Could not capture the photo. Please try again.';
        selfieError.classList.remove('hidden');
        return;
      }
      attachFile(new File([blob], 'selfie.jpg', { type: 'image/jpeg' }));
      closeSelfie();
    }, 'image/jpeg', 0.85);
  }

  window.addEventListener('beforeunload', closeSelfie);
</script>
</html>