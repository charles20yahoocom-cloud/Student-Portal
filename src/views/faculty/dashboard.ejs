<%- include('../partials/header', { user: user }) %>
  <%- include('../partials/staff-topnav', { active: 'dashboard', links: [['/faculty/dashboard','Dashboard'],['/faculty/subjects','My Subjects'],['/faculty/grade-entry','Grade Entry'],['/profile','Profile']] }) %>

<div class="flex min-h-screen">
  <%- include('../partials/faculty-sidebar', { active: 'dashboard', user: user }) %>

  <!-- Main Content -->
  <main class="flex-1 min-w-0 p-4 sm:p-6 lg:p-8">
    <!-- Welcome Banner -->
    <div class="hero">
      <h1 class="text-2xl font-bold">Teacher Dashboard</h1>
      <p class="mt-2 opacity-90">
        <%= activeSemester ? activeSemester.name + ' ' + activeSemester.school_year : 'No active semester' %>
      </p>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <div class="panel p-6">
        <p class="text-gray-500 text-sm">My Classes</p>
        <p class="text-3xl font-bold text-gray-800 mt-2"><%= classes.length %></p>
      </div>
      <div class="panel p-6">
        <p class="text-gray-500 text-sm">My Students</p>
        <p class="text-3xl font-bold text-gray-800 mt-2"><%= teacherStudents.length %></p>
      </div>
    </div>

    <!-- My Classes -->
    <div class="panel">
      <div class="p-6 border-b">
        <h2 class="text-lg font-semibold text-gray-800">My Classes</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Course</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Section</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Students</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Graded</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% if (classes.length > 0) { %>
              <% classes.forEach(c => { %>
                <tr>
                  <td class="px-6 py-4 font-medium text-gray-800"><%= c.course_code %></td>
                  <td class="px-6 py-4 text-gray-600"><%= c.course_name %> (Sec. <%= c.section %>)</td>
                  <td class="px-6 py-4 text-gray-600"><%= c.enrolled_count %></td>
                  <td class="px-6 py-4 text-gray-600"><%= c.graded_count %>/<%= c.enrolled_count %></td>
                  <td class="px-6 py-4">
                    <% if (c.enrolled_count > 0 && c.graded_count >= c.enrolled_count) { %>
                      <span class="px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">Graded</span>
                    <% } else { %>
                      <span class="px-3 py-1 rounded-full text-sm font-medium bg-amber-100 text-amber-800">Pending</span>
                    <% } %>
                  </td>
                  <td class="px-6 py-4">
                    <a href="/faculty/grade-entry/<%= c.id %>" class="text-pcc-blue hover:underline text-sm font-medium">Submit grades →</a>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="6" class="px-6 py-8 text-center text-gray-500">No classes assigned for this semester</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Current semester student roster -->
    <div class="panel mt-8">
      <div class="p-6 border-b">
        <h2 class="text-lg font-semibold text-gray-800">My Students</h2>
        <p class="text-sm text-gray-500 mt-1">
          <%= activeSemester ? activeSemester.name + ' ' + activeSemester.school_year : 'No active semester' %>
        </p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Student No.</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Program</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Year Level</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% if (teacherStudents.length > 0) { %>
              <% teacherStudents.forEach(student => { %>
                <tr>
                  <td class="px-6 py-4 font-medium text-gray-800"><%= student.student_no %></td>
                  <td class="px-6 py-4 text-gray-600"><%= student.last_name %>, <%= student.first_name %></td>
                  <td class="px-6 py-4 text-gray-600"><%= student.program_code %></td>
                  <td class="px-6 py-4 text-gray-600">Year <%= student.year_level %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="4" class="px-6 py-8 text-center text-gray-500">
                  No enrolled students in your classes for this semester.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>