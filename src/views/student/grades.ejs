<%- include('../partials/header', { user: user }) %>

<div class="flex min-h-screen">
  <!-- Sidebar -->
  <aside class="hidden md:flex md:flex-col md:w-64 md:shrink-0 bg-white shadow-lg">
    <div class="p-6 border-b">
      <div class="flex items-center space-x-3">
        <div class="w-12 h-12 bg-pcc-blue rounded-full flex items-center justify-center overflow-hidden">
          <% if (student.profile_picture) { %>
            <img src="<%= student.profile_picture %>" alt="Profile" class="w-full h-full object-cover">
          <% } else { %>
            <span class="text-white font-bold text-lg"><%= student.first_name[0] %><%= student.last_name[0] %></span>
          <% } %>
        </div>
        <div>
          <p class="font-semibold text-gray-800"><%= student.first_name %> <%= student.last_name %></p>
          <p class="text-xs text-gray-500"><%= student.student_no %></p>
        </div>
      </div>
    </div>

    <nav class="p-4 space-y-2">
      <a href="/student/dashboard" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
        </svg>
        <span>Dashboard</span>
      </a>
      <a href="/student/grades" class="flex items-center space-x-3 px-4 py-3 bg-pcc-blue/10 text-pcc-blue rounded-lg font-medium">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
        </svg>
        <span>My Grades</span>
      </a>
      <a href="/student/prospectus" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <span>My Prospectus</span>
      </a>
      <a href="/student/notifications" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition relative">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
        </svg>
        <span>Notifications</span>
      </a>
      <a href="/student/profile" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        <span>Profile</span>
      </a>
    </nav>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 min-w-0 p-4 sm:p-6 md:p-8 pb-24 md:pb-8">
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-800">My Grades</h1>
      <p class="text-gray-600 mt-1">View your academic performance by semester</p>
    </div>

    <% 
      // Group grades by semester
      const semesters = {};
      grades.forEach(g => {
        const key = `${g.school_year} - ${g.semester_name}`;
        if (!semesters[key]) semesters[key] = [];
        semesters[key].push(g);
      });
    %>

    <% if (Object.keys(semesters).length > 0) { %>
      <% for (const [semester, semesterGrades] of Object.entries(semesters)) { %>
        <div class="panel mb-6">
          <div class="p-6 border-b bg-pcc-blue/5">
            <h2 class="text-lg font-semibold text-gray-800"><%= semester %></h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-3 py-2.5 sm:px-6 sm:py-3 text-left text-xs font-medium text-gray-500 uppercase">Course Code</th>
                  <th class="px-3 py-2.5 sm:px-6 sm:py-3 text-left text-xs font-medium text-gray-500 uppercase">Credits</th>
                  <th class="px-3 py-2.5 sm:px-6 sm:py-3 text-left text-xs font-medium text-gray-500 uppercase">Grade</th>
                  <th class="px-3 py-2.5 sm:px-6 sm:py-3 text-left text-xs font-medium text-gray-500 uppercase">Points</th>
                  <th class="px-3 py-2.5 sm:px-6 sm:py-3 text-left text-xs font-medium text-gray-500 uppercase">Remarks</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <% semesterGrades.forEach(g => { %>
                  <tr>
                    <td class="px-3 py-3 sm:px-6 sm:py-4 whitespace-nowrap font-medium text-gray-800"><%= g.course_code %></td>
                    <td class="px-3 py-3 sm:px-6 sm:py-4 whitespace-nowrap text-gray-600"><%= g.credits %></td>
                    <td class="px-3 py-3 sm:px-6 sm:py-4 whitespace-nowrap">
                      <span class="px-3 py-1 rounded-full text-sm font-medium 
                        <%= (g.grade_points != null && Number(g.grade_points) < 2) ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800' %>">
                        <%= g.grade_value || '---' %>
                      </span>
                    </td>
                    <td class="px-3 py-3 sm:px-6 sm:py-4 whitespace-nowrap text-gray-600"><%= g.grade_points || '---' %></td>
                    <td class="px-3 py-3 sm:px-6 sm:py-4 whitespace-nowrap text-gray-600"><%= g.remarks || '' %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    <% } else { %>
      <div class="panel p-12 text-center">
        <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
        </svg>
        <h3 class="text-lg font-medium text-gray-800 mb-2">No Grades Yet</h3>
        <p class="text-gray-500">Your grades will appear here once they are released.</p>
      </div>
    <% } %>
  </main>
</div>

<%- include('../partials/student-mobile-nav', { active: 'grades' }) %>

<%- include('../partials/footer') %>
