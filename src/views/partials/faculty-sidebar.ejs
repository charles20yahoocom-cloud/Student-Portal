<%
  const activeKey = (typeof active !== 'undefined') ? active : '';
  const nav = [
    { key: 'dashboard',   href: '/faculty/dashboard',   label: 'Dashboard',
      icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
    { key: 'subjects',    href: '/faculty/subjects',    label: 'My Subjects',
      icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
    { key: 'grade-entry', href: '/faculty/grade-entry', label: 'Grade Entry',
      icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
    { key: 'profile',     href: '/faculty/profile',     label: 'Profile',
      icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' }
  ];
%>
<!-- Sidebar -->
<aside class="hidden lg:flex lg:flex-col lg:w-64 lg:shrink-0 bg-white shadow-lg">
  <div class="p-6 border-b">
    <div class="flex items-center space-x-3">
      <div class="w-12 h-12 bg-pcc-blue rounded-full flex items-center justify-center">
        <span class="text-white font-bold text-lg">F</span>
      </div>
      <div>
        <p class="font-semibold text-gray-800"><%= user.fullName %></p>
        <p class="text-xs text-gray-500 capitalize"><%= user.role %></p>
      </div>
    </div>
  </div>

  <nav class="p-4 space-y-2">
    <% nav.forEach(item => { const on = item.key === activeKey; %>
      <a href="<%= item.href %>"
         class="flex items-center space-x-3 px-4 py-3 rounded-lg transition <%= on ? 'bg-pcc-blue/10 text-pcc-blue font-medium' : 'text-gray-600 hover:bg-gray-100' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= item.icon %>"></path>
        </svg>
        <span><%= item.label %></span>
      </a>
    <% }); %>
  </nav>
</aside>
