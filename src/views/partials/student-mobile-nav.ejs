<%
  const activeKey = (typeof active !== 'undefined') ? active : '';
  const unread = (typeof unreadCount !== 'undefined' && unreadCount) ? unreadCount : 0;
  const links = [
    { href: '/student/dashboard', key: 'dashboard', label: 'Home',
      icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
    { href: '/student/grades', key: 'grades', label: 'Grades',
      icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2' },
    { href: '/student/prospectus', key: 'prospectus', label: 'Prospectus',
      icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
    { href: '/student/notifications', key: 'notifications', label: 'Alerts',
      icon: 'M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9' },
    { href: '/student/profile', key: 'profile', label: 'Profile',
      icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' }
  ];
%>
<!-- Mobile bottom tab bar (hidden on md and up) -->
<nav class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur border-t border-gray-200 shadow-[0_-2px_10px_rgba(0,0,0,0.05)]"
     style="padding-bottom: env(safe-area-inset-bottom)">
  <div class="grid grid-cols-5">
    <% links.forEach(l => { const on = l.key === activeKey; %>
      <a href="<%= l.href %>" class="relative flex flex-col items-center justify-center py-2 <%= on ? 'text-pcc-blue' : 'text-gray-500' %>">
        <svg class="w-6 h-6 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= on ? 2.4 : 2 %>" d="<%= l.icon %>"></path>
        </svg>
        <span class="text-[11px] leading-none <%= on ? 'font-semibold' : '' %>"><%= l.label %></span>
        <% if (l.key === 'notifications' && unread > 0) { %>
          <span class="absolute top-1 right-[22%] min-w-[16px] h-4 px-1 bg-red-500 text-white text-[10px] rounded-full flex items-center justify-center"><%= unread %></span>
        <% } %>
      </a>
    <% }); %>
  </div>
</nav>
