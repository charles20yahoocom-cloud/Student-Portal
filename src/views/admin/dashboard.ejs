<%- include('../partials/header', { user: user }) %>
  <%- include('../partials/staff-topnav', { active: 'dashboard', links: [['/admin/dashboard','Dashboard'],['/admin/accounts','Staff Accounts'],['/profile','Profile']] }) %>

<div class="flex min-h-screen">
  <!-- Sidebar -->
  <aside class="hidden lg:flex lg:flex-col lg:w-64 lg:shrink-0 bg-white shadow-lg">
    <div class="p-6 border-b">
      <div class="flex items-center space-x-3">
        <div class="w-12 h-12 bg-pcc-blue rounded-full flex items-center justify-center">
          <span class="text-white font-bold text-lg">A</span>
        </div>
        <div>
          <p class="font-semibold text-gray-800"><%= user.fullName %></p>
          <p class="text-xs text-gray-500 capitalize"><%= user.role %></p>
        </div>
      </div>
    </div>

    <nav class="p-4 space-y-2">
      <a href="/admin/dashboard" class="flex items-center space-x-3 px-4 py-3 bg-pcc-blue/10 text-pcc-blue rounded-lg font-medium">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
        </svg>
        <span>Dashboard</span>
      </a>
      <a href="/admin/accounts" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
        </svg>
        <span>Staff Accounts</span>
      </a>
      <a href="/profile" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        <span>Profile</span>
      </a>
    </nav>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 min-w-0 p-4 sm:p-6 lg:p-8">
    <!-- Welcome Banner -->
    <div class="hero">
      <h1 class="text-2xl font-bold">Admin Dashboard</h1>
      <p class="mt-2 opacity-90">Manage staff accounts and monitor the portal</p>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <div class="panel p-6">
        <p class="text-gray-500 text-sm">Registered Students</p>
        <p class="text-3xl font-bold text-gray-800 mt-2"><%= totalStudents %></p>
      </div>
      <div class="panel p-6">
        <p class="text-gray-500 text-sm">Faculty / Teachers</p>
        <p class="text-3xl font-bold text-gray-800 mt-2"><%= totalFaculty %></p>
      </div>
      <div class="panel p-6">
        <p class="text-gray-500 text-sm">Deans</p>
        <p class="text-3xl font-bold text-gray-800 mt-2"><%= totalDean %></p>
      </div>
      <div class="panel p-6">
        <p class="text-gray-500 text-sm">Admins</p>
        <p class="text-3xl font-bold text-gray-800 mt-2"><%= totalAdmins %></p>
      </div>
    </div>

    <!-- Recent Students -->
    <div class="panel">
      <div class="p-6 border-b flex items-center justify-between">
        <h2 class="text-lg font-semibold text-gray-800">Recently Registered Students</h2>
        <a href="/admin/accounts" class="text-sm text-pcc-blue font-medium hover:underline">Manage staff accounts</a>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Student No.</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Program</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Year / Section</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% if (recentStudents.length > 0) { %>
              <% recentStudents.forEach(s => { %>
                <tr>
                  <td class="px-6 py-4 text-gray-600"><%= s.student_no %></td>
                  <td class="px-6 py-4 font-medium text-gray-800"><%= s.last_name %>, <%= s.first_name %></td>
                  <td class="px-6 py-4 text-gray-600"><%= s.program_code %></td>
                  <td class="px-6 py-4 text-gray-600"><%= s.year_level %> - <%= s.section %></td>
                  <td class="px-6 py-4 text-gray-600"><%= s.email %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" class="px-6 py-8 text-center text-gray-500">No students registered yet</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>