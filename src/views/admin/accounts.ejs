<%- include('../partials/header', { user: user }) %>
  <%- include('../partials/staff-topnav', { active: 'accounts', links: [['/admin/dashboard','Dashboard'],['/admin/accounts','Staff Accounts']] }) %>

<div class="flex min-h-screen">
  <!-- Sidebar -->
  <aside class="hidden lg:flex lg:flex-col lg:w-64 lg:shrink-0 bg-white shadow-lg">
    <div class="p-6 border-b">
      <div class="flex items-center space-x-3">
        <div class="w-12 h-12 bg-pcc-blue rounded-full flex items-center justify-center">
          <span class="text-white font-bold text-lg">A</span>
        </div>
        <div>
          <p class="font-semibold text-gray-800"><%= user.fullName %></p>
          <p class="text-xs text-gray-500 capitalize"><%= user.role %></p>
        </div>
      </div>
    </div>

    <nav class="p-4 space-y-2">
      <a href="/admin/dashboard" class="flex items-center space-x-3 px-4 py-3 text-gray-600 hover:bg-gray-100 rounded-lg transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
        </svg>
        <span>Dashboard</span>
      </a>
      <a href="/admin/accounts" class="flex items-center space-x-3 px-4 py-3 bg-pcc-blue/10 text-pcc-blue rounded-lg font-medium">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
        </svg>
        <span>Staff Accounts</span>
      </a>
    </nav>
  </aside>

  <!-- Main Content -->
  <main class="flex-1 min-w-0 p-4 sm:p-6 lg:p-8">
    <div class="hero">
      <h1 class="text-2xl font-bold">Staff Accounts</h1>
      <p class="mt-2 opacity-90">Create and manage dean, faculty, and registrar accounts</p>
    </div>

    <!-- Flash Messages -->
    <% if (success) { %>
      <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6 text-sm"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6 text-sm"><%= error %></div>
    <% } %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Create Account Form -->
      <div class="panel p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Create Staff Account</h2>
        <form action="/admin/accounts" method="POST" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
            <input type="text" name="full_name" required placeholder="e.g. Jane Q. Smith"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pcc-blue focus:border-transparent outline-none transition">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
            <input type="email" name="email" required placeholder="jane.smith@pcc.edu.ph"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pcc-blue focus:border-transparent outline-none transition">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Role</label>
            <select name="role" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pcc-blue focus:border-transparent outline-none transition bg-white">
              <option value="">Select role</option>
              <option value="dean">Dean</option>
              <option value="faculty">Faculty / Teacher</option>
              <option value="registrar">Registrar</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Password</label>
            <input type="password" name="password" required placeholder="At least 6 characters"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pcc-blue focus:border-transparent outline-none transition">
          </div>
          <button type="submit" class="w-full bg-pcc-blue hover:bg-pcc-blue-dark text-white font-semibold py-3 rounded-lg transition duration-200">
            Create Account
          </button>
        </form>
      </div>

      <!-- Staff List -->
      <div class="panel lg:col-span-2">
        <div class="p-6 border-b">
          <h2 class="text-lg font-semibold text-gray-800">Staff List</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Role</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% if (staff.length > 0) { %>
                <% staff.forEach(a => { %>
                  <tr>
                    <td class="px-6 py-4 font-medium text-gray-800"><%= a.full_name %></td>
                    <td class="px-6 py-4 text-gray-600"><%= a.email %></td>
                    <td class="px-6 py-4">
                      <span class="px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800 capitalize"><%= a.role %></span>
                    </td>
                    <td class="px-6 py-4">
                      <% if (a.is_active) { %>
                        <span class="px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">Active</span>
                      <% } else { %>
                        <span class="px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">Inactive</span>
                      <% } %>
                    </td>
                    <td class="px-6 py-4">
                      <% if (a.role !== 'admin') { %>
                        <form action="/admin/accounts/<%= a.id %>/toggle" method="POST">
                          <button type="submit" class="text-sm font-medium <%= a.is_active ? 'text-red-600 hover:text-red-800' : 'text-green-600 hover:text-green-800' %>">
                            <%= a.is_active ? 'Deactivate' : 'Activate' %>
                          </button>
                        </form>
                      <% } else { %>
                        <span class="text-sm text-gray-400">-</span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="px-6 py-8 text-center text-gray-500">No staff accounts yet</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <!-- Department Heads -->
    <div class="panel mt-6">
      <div class="p-6 border-b">
        <h2 class="text-lg font-semibold text-gray-800">Department Heads</h2>
        <p class="text-sm text-gray-500 mt-1">Each dean only sees students of the department they head. Admins see everything.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Department</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Current Head</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Assign Head</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% (departments || []).forEach(d => { %>
              <tr>
                <td class="px-6 py-4 font-medium text-gray-800"><%= d.code %> <span class="text-sm font-normal text-gray-500">— <%= d.name %></span></td>
                <td class="px-6 py-4 text-gray-600"><%= d.hod_name || '—' %></td>
                <td class="px-6 py-4">
                  <form action="/admin/hod" method="POST" class="flex flex-wrap items-center gap-2">
                    <input type="hidden" name="department_id" value="<%= d.id %>">
                    <select name="user_id" class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-pcc-blue focus:border-transparent outline-none bg-white">
                      <option value="">— No head —</option>
                      <% (deans || []).forEach(dn => { %>
                        <option value="<%= dn.id %>" <%= d.hod_user_id === dn.id ? 'selected' : '' %>><%= dn.full_name %> (<%= dn.email %>)</option>
                      <% }) %>
                    </select>
                    <button type="submit" class="bg-pcc-blue hover:bg-pcc-blue-dark text-white text-sm font-medium px-4 py-2 rounded-lg transition">Save</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>