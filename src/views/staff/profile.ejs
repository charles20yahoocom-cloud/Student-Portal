<%- include('../partials/header', { user: user }) %>

<main class="max-w-5xl mx-auto p-4 sm:p-6 lg:p-8">
  <a href="<%= home %>" class="inline-flex items-center text-pcc-blue hover:text-pcc-blue-dark mb-4 font-medium">
    &larr; Back to Dashboard
  </a>

  <div class="hero">
    <h1 class="text-2xl font-bold">Profile Settings</h1>
    <p class="mt-2 opacity-90">Manage your account details, password, and photo</p>
  </div>

  <% if (saved) { %>
    <div class="mb-6 rounded-xl border px-4 py-3 text-sm font-medium"
         style="background: rgba(22,163,74,.08); border-color: rgba(22,163,74,.3); color:#166534;">
      Profile updated successfully.
    </div>
  <% } %>
  <% if (pwSaved) { %>
    <div class="mb-6 rounded-xl border px-4 py-3 text-sm font-medium"
         style="background: rgba(22,163,74,.08); border-color: rgba(22,163,74,.3); color:#166534;">
      Password changed successfully.
    </div>
  <% } %>
  <% if (error) { %>
    <div class="mb-6 rounded-xl border px-4 py-3 text-sm font-medium"
         style="background: rgba(220,38,38,.07); border-color: rgba(220,38,38,.3); color:#991b1b;">
      <%= error %>
    </div>
  <% } %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Photo + account card -->
    <div class="lg:col-span-1 space-y-6">
      <div class="panel p-6 text-center">
        <div class="relative w-28 h-28 mx-auto mb-4">
          <img id="avatarImg" src="<%= userDetails.profile_picture || '' %>" alt="Profile photo"
               class="w-28 h-28 rounded-full object-cover ring-4 ring-gold-500/40 <%= userDetails.profile_picture ? '' : 'hidden' %>">
          <div id="avatarInitials"
               class="w-28 h-28 rounded-full flex items-center justify-center text-3xl font-bold <%= userDetails.profile_picture ? 'hidden' : '' %>"
               style="background: linear-gradient(135deg,#EFD27A,#D4AF37); color:#0B1747; box-shadow: 0 0 0 4px rgba(212,175,55,.3);">
            <%= (userDetails.full_name || 'U').split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase() %>
          </div>
        </div>
        <h2 class="font-display text-lg font-bold text-royal-900"><%= userDetails.full_name %></h2>
        <p class="text-sm text-gray-500"><%= roleLabel %></p>

        <div class="flex items-center justify-center gap-2 mt-4">
          <button onclick="document.getElementById('photoInput').click()"
                  class="px-3 py-1.5 rounded-lg text-sm font-medium text-white transition"
                  style="background: linear-gradient(135deg,#2A5BD7,#16307F); border:1px solid rgba(212,175,55,.35);">
            Upload Photo
          </button>
          <% if (userDetails.profile_picture) { %>
            <button onclick="removePhoto()" class="px-3 py-1.5 rounded-lg text-sm font-medium text-gray-600 bg-gray-100 hover:bg-gray-200 transition">
              Remove
            </button>
          <% } %>
        </div>
        <input type="file" id="photoInput" accept="image/jpeg,image/png,image/webp" class="hidden" onchange="uploadPhoto(this.files[0])">
        <p class="text-xs text-gray-400 mt-2">JPG, PNG, or WebP &middot; max 5 MB</p>
      </div>

      <div class="panel p-6 space-y-3 text-sm">
        <div class="flex items-center justify-between">
          <span class="text-gray-500">Role</span>
          <span class="font-medium text-royal-900"><%= roleLabel %></span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-gray-500">Account ID</span>
          <span class="font-medium text-royal-900">#<%= userDetails.id %></span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-gray-500">Member since</span>
          <span class="font-medium text-royal-900"><%= (userDetails.created_at || '').slice(0, 10) %></span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-gray-500">Two-Factor Auth</span>
          <% if (userDetails.totp_enabled) { %>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800">Enabled</span>
          <% } else { %>
            <a href="/2fa/setup" class="text-pcc-blue font-medium hover:underline">Set up &rarr;</a>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Forms -->
    <div class="lg:col-span-2 space-y-6">
      <div class="panel">
        <div class="p-6 border-b">
          <h2 class="text-lg font-semibold text-royal-900">Account Information</h2>
          <p class="text-sm text-gray-500 mt-1">Update your display name and sign-in email.</p>
        </div>
        <form action="<%= profilePath %>" method="POST" class="p-6 space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Full Name</label>
            <input type="text" name="full_name" value="<%= userDetails.full_name %>" required
                   class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-lg outline-none transition">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Email Address</label>
            <input type="email" name="email" value="<%= userDetails.email %>" required
                   class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-lg outline-none transition">
          </div>
          <div class="flex justify-end">
            <button type="submit" class="px-5 py-2.5 rounded-lg text-white font-semibold transition"
                    style="background: linear-gradient(135deg,#2A5BD7,#16307F); border:1px solid rgba(212,175,55,.35); box-shadow: 0 10px 22px -12px rgba(22,48,127,.8);">
              Save Changes
            </button>
          </div>
        </form>
      </div>

      <div class="panel">
        <div class="p-6 border-b">
          <h2 class="text-lg font-semibold text-royal-900">Change Password</h2>
          <p class="text-sm text-gray-500 mt-1">Choose a strong password of at least 8 characters.</p>
        </div>
        <form action="<%= profilePath %>/password" method="POST" class="p-6 space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Current Password</label>
            <input type="password" name="current_password" required autocomplete="current-password"
                   class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-lg outline-none transition">
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">New Password</label>
              <input type="password" name="new_password" required minlength="8" autocomplete="new-password"
                     class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-lg outline-none transition">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Confirm New Password</label>
              <input type="password" name="confirm_password" required minlength="8" autocomplete="new-password"
                     class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-lg outline-none transition">
            </div>
          </div>
          <div class="flex justify-end">
            <button type="submit" class="px-5 py-2.5 rounded-lg text-white font-semibold transition"
                    style="background: linear-gradient(135deg,#2A5BD7,#16307F); border:1px solid rgba(212,175,55,.35); box-shadow: 0 10px 22px -12px rgba(22,48,127,.8);">
              Update Password
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<script>
  async function uploadPhoto(file) {
    if (!file) return;
    const fd = new FormData();
    fd.append('picture', file);
    const res = await fetch('<%= profilePath %>/picture', { method: 'POST', body: fd });
    const data = await res.json().catch(() => ({}));
    if (data.success) {
      const img = document.getElementById('avatarImg');
      img.src = data.url + '?t=' + Date.now();
      img.classList.remove('hidden');
      document.getElementById('avatarInitials').classList.add('hidden');
      window.location.reload();
    } else {
      alert(data.error || 'Upload failed');
    }
    document.getElementById('photoInput').value = '';
  }

  async function removePhoto() {
    if (!confirm('Remove your profile photo?')) return;
    const res = await fetch('<%= profilePath %>/picture', { method: 'DELETE' });
    if (res.ok) window.location.reload();
  }
</script>

<%- include('../partials/footer') %>
