PORT=3005
HOST=0.0.0.0
NODE_ENV=production
# SQLite database. In production without DB_PATH, the app defaults to
# %ProgramData%\PCCPortal\data\pcc.db (persistent on Render). For a
# Render persistent disk set it to the persistent path.
DB_PATH=./src/database/pcc.db

# Profile photo folder. In production without UPLOAD_DIR, the app defaults to
# %ProgramData%\PCCPortal\data\uploads (persistent on Render).
UPLOAD_DIR=./uploads

# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_VALUE
SESSION_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_VALUE

# Cookies are Secure automatically in production. Keep true for hosted/public
# sites. Set to false only for a plain-HTTP LAN demo.
COOKIE_SECURE=true

# Only trust proxy headers from your reverse proxy. "loopback" is right for a
# direct deployment; set to "1" behind one proxy, or a specific number for
# multiple hops.
TRUST_PROXY=loopback

# Password reset email (optional). Without these, reset disables itself with
# a "contact the Dean" message.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
