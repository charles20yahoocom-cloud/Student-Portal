# Copy this file to .env and fill in real values. Never commit .env.
PORT=3005
HOST=0.0.0.0
NODE_ENV=development
# SQLite database file. Relative paths resolve inside src/ (development).
# For an installed server, use an absolute path outside the app folder so
# updates/reinstalls keep the data, e.g. C:\ProgramData\PCCPortal\data\pcc.db
# In production, if DB_PATH is unset, the app defaults to
# %ProgramData%\PCCPortal\data\pcc.db (unless an older in-project DB exists).
DB_PATH=./database/pcc.db

# Profile photo folder. Same idea as DB_PATH. In production, if unset, it
# defaults to %ProgramData%\PCCPortal\data\uploads.
# UPLOAD_DIR=./uploads

# Generate each secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
SESSION_SECRET=replace-with-another-long-random-value

# Cookies are Secure automatically in production. On a plain-HTTP LAN demo,
# set this to false or login will silently fail.
# COOKIE_SECURE=false

# Only trust proxy headers from your reverse proxy. Leave loopback for a direct
# LAN deployment; set to "1" for one proxy hop, or false to trust none.
TRUST_PROXY=loopback

# Password reset email (optional). Without these, the reset form politely
# disables itself instead of exposing a code.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@pcc.edu.ph
# SMTP_PASS=change-me
# SMTP_FROM=PCC Student Portal <no-reply@pcc.edu.ph>
